{
    // General settings 
    "security.workspace.trust.untrustedFiles": "open",
    "window.zoomLevel": 1,
    "extensions.autoUpdate": "on",
    // Workbench settings (layout & Appearance)
    "workbench.colorTheme": "Catppuccin Macchiato",
    "workbench.sideBar.location": "right",
    "workbench.activityBar.location": "top",
    "workbench.statusBar.visible": true,
    "workbench.startupEditor": "none",
    "workbench.iconTheme": "material-icon-theme",
    "material-icon-theme.hidesExplorerArrows": true,
    "material-icon-theme.folders.color": "#F9E2AF",
    "workbench.tree.enableStickyScroll": true,
    "workbench.tree.renderIndentGuides": "onHover",
    "workbench.tree.indent": 25,
    "workbench.productIconTheme": "bongocat",
    // Editor settings 
    "editor.fontFamily": "Hack Nerd Font",
    "editor.colorDecorators": true,
    "editor.minimap.enabled": false,
    "editor.accessibilityPageSize": 16,
    "editor.fontSize": 22,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnSaveMode": "file",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorBlinking": "blink",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 5,
    "workbench.colorCustomizations": {
        "editorCursor.background": "#1e1e2e",
        "editorCursor.foreground": "#f5e0dc"
    },
    // Explorer settings
    "explorer.compactFolders": false,
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmUndo": false,
    // File system settings
    "files.autoSave": "onFocusChange",
    // Python settings 
    "python.analysis.typeCheckingMode": "strict",
    // Terminal window settings 
    "terminal.integrated.fontSize": 20,
    "redhat.telemetry.enabled": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "jupyter.askForKernelRestart": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },
    "yaml.disableSchemaDetection": [
        "**/docker-compose.yml",
        "**/docker-compose.yaml",
        "**/docker-compose.*.yml",
        "**/docker-compose.*.yaml",
        "**/compose.yml",
        "**/compose.yaml",
        "**/compose.*.yml",
        "**/compose.*.yaml",
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
  "material-icon-theme.folders.customClones": [
    {
      "name": "tui",
      "base": "ui",
      "color": "#E223ECE2",
      "folderNames": ["tui","terminal_interface","terminal_app"]
    }
  ]
}